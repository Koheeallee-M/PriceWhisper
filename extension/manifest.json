
{
  "manifest_version": 3,
  "name": "PriceWhisper",
  "version": "1.1.0",
  "description": "Compare prices and track product deals.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_title": "PriceWhisper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}

